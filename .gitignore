# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
backend/.venv/

# Secrets: your keys, database password and Google client live here. Never commit.
backend/.env
.env

# Your own data (runs, accounts, notes, logs) stays on your laptop / in MongoDB
backend/runs/*
!backend/runs/.gitkeep
backend/users/
backend/logs/
backend/context/
backend/.claude_skills.json

# Frontend
node_modules/

# Old app builds pile up in dist/assets: keep only the current one (named in dist/index.html).
# (Claude updates these two lines whenever it rebuilds the app.)
frontend/dist/assets/*
!frontend/dist/assets/index-DKQK6gFs.js
!frontend/dist/assets/index-Cv6epyp0.css

# Old, unused file still on the laptop
backend/app/parsing/prompts.py
