# ============================================================
#  backend\.env  -  Matcher's private settings (passwords and keys)
#  Copy this file to .env, fill in your values, save, then run run.bat again.
#  Never share .env or paste its contents anywhere: it contains passwords.
#  The values below are EXAMPLES. Replace them with your own.
# ============================================================

# ---------- 1. Database: MongoDB Atlas (required) ----------
# Where Matcher keeps user accounts and sign-in sessions.
# Get it: cloud.mongodb.com > your cluster > Connect > Drivers > copy the connection string.
#   - "mydbuser" is the DATABASE USER (Atlas > Database Access), not your email.
#   - Replace <db_password> with that database user's password (no < > brackets).
#   - If the password has  @ : / ? # % &  in it, change it to letters and numbers only.
#   - Atlas > Network Access must allow your current IP address.
MONGODB_URI=mongodb+srv://mydbuser:MyDbPassw0rd@cluster0.abcde12.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# The name of the database INSIDE your cluster that Matcher uses. Matcher creates it (and its
# "users" and "sessions" collections) automatically the first time you sign in. Keep "matcher"
# unless you want a different name.
MONGODB_DB=matcher

# ---------- 2. Sign in with Google (required) ----------
# Get it: console.cloud.google.com > APIs & Services > Credentials > Create credentials >
# OAuth client ID > Web application. Authorized JavaScript origins:
#   http://localhost:8000   and   http://localhost
#   (+ http://localhost:5173 if you open the app through "npm run dev")
# Paste the "Client ID" (not the client secret; Matcher doesn't need the secret).
GOOGLE_CLIENT_ID=123456789012-abc123def456ghi789jkl0mnopqrstu.apps.googleusercontent.com
#   Online (e.g. Render): also add your site's address, e.g. https://matcher-xxxx.onrender.com

# Who may sign in: Google account emails, separated by commas. Empty = any Google account
# (fine on your own laptop). ALWAYS set it when the app is online, or anyone could sign in
# and use your AI key.
ALLOWED_EMAILS=you@gmail.com

# ---------- 3. AI provider (at least ONE key) ----------
# Matcher uses the first one it finds, in this order (config/models.yaml, provider: auto):
#   ANTHROPIC_API_KEY   Claude    (platform.claude.com)   - steps run as Agent Skills
#   GEMINI_API_KEY      Gemini    (aistudio.google.com)   - free tier available
#   OPENROUTER_API_KEY  OpenRouter (openrouter.ai/keys)    - many models with one key
#   OPENAI_API_KEY      OpenAI or any OpenAI-compatible API (set OPENAI_BASE_URL for others)
# Leave the ones you don't use empty.
# Privacy: free tiers may use what you send to improve their products. Use a paid key for
# your real resume.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=AIzaSyA-example-only-replace-me
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: shown to OpenRouter as your app's name/URL
OPENROUTER_APP_NAME=Matcher
OPENROUTER_APP_URL=http://localhost:8000
